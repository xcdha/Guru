{
  "$comment": "Proma → Guru 同步后 rename / 门禁规则。apply-renames 与 sync:check 共用。",
  "skipDirNames": [
    ".git",
    "node_modules",
    "dist",
    "out",
    "output",
    ".superpowers",
    ".playwright-mcp",
    ".cursor",
    "storage",
    "coverage"
  ],
  "skipFileGlobs": [
    "**/bun.lock",
    "**/*.lock",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.icns",
    "**/*.woff",
    "**/*.woff2",
    "**/*.ttf",
    "**/*.eot",
    "**/*.mp4",
    "**/*.zip",
    "**/*.dmg",
    "**/*.exe",
    "**/*.node",
    "**/*.pdf"
  ],
  "allowlistGlobs": [
    "**/migration-service.ts",
    "**/scripts/upstream-sync/**",
    "**/release-notes/**",
    "**/docs/**",
    "**/tutorial/**"
  ],
  "warnOnlyGlobs": [
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "README.en.md",
    "**/docs/plans/**"
  ],
  "replacements": [
    {
      "from": "@anthropic-ai/Codex-agent-sdk",
      "to": "@anthropic-ai/claude-agent-sdk"
    },
    {
      "from": "Codex-agent-sdk",
      "to": "claude-agent-sdk"
    },
    {
      "from": "@proma/",
      "to": "@guru/"
    },
    {
      "from": "~/.proma",
      "to": "~/.guru"
    },
    {
      "from": ".proma-dev",
      "to": ".guru-dev"
    },
    {
      "from": "/.proma/",
      "to": "/.guru/"
    },
    {
      "from": "\"@proma/",
      "to": "\"@guru/"
    },
    {
      "from": "requiresPromaUserAgent",
      "to": "requiresAppUserAgent"
    },
    {
      "from": "getPromaUserAgent",
      "to": "getAppUserAgent"
    },
    {
      "from": "setPromaVersion",
      "to": "setAppVersion"
    },
    {
      "from": "PromaPermissionMode",
      "to": "GuruPermissionMode"
    },
    {
      "from": "proma_event",
      "to": "guru_event"
    },
    {
      "from": "_promaLiveRunStartedAt",
      "to": "_guruLiveRunStartedAt"
    }
  ],
  "forbiddenPatterns": [
    {
      "id": "pkg-scope",
      "regex": "@proma/",
      "message": "残留 @proma/ 包作用域，应改为 @guru/"
    },
    {
      "id": "home-proma",
      "regex": "~/.proma",
      "message": "残留 ~/.proma 路径，应改为 ~/.guru"
    },
    {
      "id": "dot-proma",
      "regex": "(^|[\"'`\\s])/\\.proma(/|[\"'`\\s]|$)|\\.proma-dev",
      "message": "残留 .proma / .proma-dev 路径片段"
    },
    {
      "id": "codex-sdk-typo",
      "regex": "Codex-agent-sdk",
      "message": "错误 SDK 包名 Codex-agent-sdk，应改为 claude-agent-sdk"
    }
  ],
  "sdkPlatformPackages": [],
  "luxOnlySkills": [
    "guru-coach",
    "guizang-ppt-skill"
  ]
}